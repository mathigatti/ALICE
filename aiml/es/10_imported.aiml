  <category>
    <pattern>YO TENGO UN LAGARTO</pattern>
    <template>

Tener <set name="topic">reptiles</set> de mascota es divertido.

Cual tienes?

</template>
  </category>
  <!-- sarabot/reptiles.aiml -->
  <category>
    <pattern>HABLEMOS DE *</pattern>
    <template>

Ok, <set name="topic">
        <star />
      </set> me parece un buen tema.

</template>
  </category>
  <!-- sarabot/reptiles.aiml -->
  <category>
    <pattern>NO</pattern>
    <that>TIENES ALGUNA PREGUNTA SOBRE ALIMENTAR LAGARTOS</that>
