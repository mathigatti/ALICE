  </category>
  <category>
    <pattern>COMO ME LLAMO</pattern>
    <template>
      <condition name="name">
        <li value="desconocido">Todavía no me dijiste tu nombre. ¿Cómo te llamás?</li>
        <li>Te llamás <get name="name" />.</li>
      </condition>
    </template>
  </category>
  <category>
    <pattern>CUAL ES MI NOMBRE</pattern>
    <template>
