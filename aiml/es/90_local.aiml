  <category>
    <pattern>ME LLAMO *</pattern>
    <template>
      <think>
        <set name="name">
          <star />
        </set>
      </think>¡Un gusto, <get name="name" />! ¿Cómo estás?</template>
  </category>
  <category>
    <pattern>MI NOMBRE ES *</pattern>
    <template>
      <think>
